<!-- Custom SOC Detection Ruleset: Suricata IDS & OpenWrt Perimeter Correlation -->
<group name="custom,suricata,openwrt,">

  <!-- Rule 100101: High-Priority Suricata IDS Signature Match -->
  <rule id="100101" level="10">
    <if_sid>86601</if_sid>
    <field name="alert.severity">^1$|^2$</field>
    <description>Suricata IDS High-Severity Alert: $(alert.signature) from $(src_ip)</description>
    <mitre>
      <id>T1190</id>
      <id>T1046</id>
    </mitre>
    <group>ids,suricata,perimeter_threat,</group>
  </rule>

  <!-- Rule 100102: Repeated OpenWrt Perimeter Firewall Drops (Port Scan / Recon) -->
  <rule id="100102" level="10" frequency="15" timeframe="60">
    <if_matched_group>firewall_drop</if_matched_group>
    <same_source_ip />
    <description>Perimeter Port Scan Detected: Multiple blocked packets from $(srcip) on OpenWrt gateway</description>
    <mitre>
      <id>T1046</id>
    </mitre>
    <group>recon,port_scan,openwrt,</group>
  </rule>

  <!-- Rule 100103: Distributed SSH Brute Force Escalation -->
  <rule id="100103" level="12" frequency="8" timeframe="120">
    <if_matched_sid>5710</if_matched_sid>
    <same_source_ip />
    <description>Critical SSH Brute Force Attack: 8+ failed login attempts from $(srcip)</description>
    <mitre>
      <id>T1110.001</id>
    </mitre>
    <group>authentication_failed,brute_force,soar_trigger,</group>
  </rule>

</group>
